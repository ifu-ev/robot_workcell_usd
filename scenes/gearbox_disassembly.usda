    def Scope "Looks"
    {
        def Material "drape_blue"
        {
            token outputs:mdl:displacement.connect = </World/Looks/drape_blue/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/drape_blue/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/drape_blue/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:albedo_add = 0
