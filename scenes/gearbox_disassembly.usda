                float inputs:specular_level = 0.78999996
                int inputs:uv_space_index = 0
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "OmniPBR"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniPBR/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.98841697, 0.4411621, 0.07632564)
                color3f inputs:diffuse_tint = (0.96525097, 0.4282757, 0.044722065)
                float inputs:reflection_roughness_constant = 0.84999996
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

