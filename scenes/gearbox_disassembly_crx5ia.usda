                custom uint64 outputs:context
            }

            def OmniGraphNode "qos"
            {
                custom token inputs:createProfile (
                    allowedTokens = ["Default for publishers/subscribers", "Services", "Sensor Data", "System Default", "Custom"]
                )
                custom double inputs:deadline
                custom uint64 inputs:depth = 5
                custom token inputs:durability = "transientLocal" (
                    allowedTokens = ["systemDefault", "transientLocal", "volatile", "unknown"]
                )
                custom token inputs:history (
                    allowedTokens = ["systemDefault", "keepLast", "keepAll", "unknown"]
                )
                custom double inputs:leaseDuration
                custom double inputs:lifespan
                custom token inputs:liveliness (
                    allowedTokens = ["systemDefault", "automatic", "manualByTopic", "unknown"]
                )
                custom token inputs:reliability = "reliable" (
                    allowedTokens = ["systemDefault", "reliable", "bestEffort", "unknown"]
                )
                token node:type = "isaacsim.ros2.bridge.ROS2QoSProfile"
                int node:typeVersion = 1
                custom string outputs:qosProfile
            }

            def OmniGraphNode "pcl"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = </World/ROS2/Camera_Publisher/ctx.outputs:context>
                custom bool inputs:enabled
                custom bool inputs:enableSemanticLabels
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Camera_Publisher/rp.outputs:execOut>
                custom string inputs:frameId = "ZividCamera"
                custom uint inputs:frameSkipCount = 0
                custom string inputs:nodeNamespace
                custom string inputs:qosProfile
                prepend string inputs:qosProfile.connect = </World/ROS2/Camera_Publisher/qos.outputs:qosProfile>
                custom uint64 inputs:queueSize
                custom token inputs:renderProductPath
                prepend token inputs:renderProductPath.connect = </World/ROS2/Camera_Publisher/rp.outputs:renderProductPath>
                custom bool inputs:resetSimulationTimeOnStop
                custom string inputs:semanticLabelsTopicName
                custom string inputs:srtxCompressionType
                custom float2 inputs:stereoOffset
                custom string inputs:topicName = "ZividCamera/pointcloud"
                custom token inputs:type = "depth_pcl" (
                    allowedTokens = ["rgb", "rgb_h264", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d"]
                )
                custom bool inputs:useSystemTime
                token node:type = "isaacsim.ros2.bridge.ROS2CameraHelper"
                int node:typeVersion = 3
            }

            def OmniGraphNode "rgb"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = </World/ROS2/Camera_Publisher/ctx.outputs:context>
                custom bool inputs:enabled
