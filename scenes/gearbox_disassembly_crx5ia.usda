                            }
                        }
                    }
                )
                token node:type = "isaacsim.core.nodes.IsaacComputeTransformTree"
                int node:typeVersion = 1
                custom token[] outputs:childFrames
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom double4[] outputs:orientations
                custom token[] outputs:parentFrames
                custom double3[] outputs:translations
            }

            def OmniGraphNode "pub"
            {
                custom token[] inputs:childFrames
                prepend token[] inputs:childFrames.connect = </World/ROS2/TF_Publisher/tree.outputs:childFrames>
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = </World/ROS2/TF_Publisher/ctx.outputs:context>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/TF_Publisher/tree.outputs:execOut>
                custom string inputs:nodeNamespace
                custom double4[] inputs:orientations
                prepend double4[] inputs:orientations.connect = </World/ROS2/TF_Publisher/tree.outputs:orientations>
                custom token[] inputs:parentFrames
                prepend token[] inputs:parentFrames.connect = </World/ROS2/TF_Publisher/tree.outputs:parentFrames>
                custom rel inputs:parentPrim (
                    customData = {
