    def Scope "ROS2"
    {
        def OmniGraph "Topic_Based_Controller"
        {
            token evaluationMode = "Automatic"
            token evaluator:type = "execution"
            token fabricCacheBacking = "StageWithoutHistory"
            int2 fileFormatVersion = (1, 9)
            token pipelineStage = "pipelineStageOnDemand"

            def OmniGraphNode "physx"
            {
                token node:type = "isaacsim.core.nodes.OnPhysicsStep"
                int node:typeVersion = 1
                custom double outputs:deltaSimulationTime
                custom double outputs:deltaSystemTime
                custom uint outputs:step (
                    customData = {
                        bool isExecution = 1
                    }
                )
            }

            def OmniGraphNode "gate"
            {
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Topic_Based_Controller/physx.outputs:step>
                custom uint inputs:step = 2
                token node:type = "isaacsim.core.nodes.IsaacSimulationGate"
                int node:typeVersion = 1
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
            }

            def OmniGraphNode "read"
            {
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Topic_Based_Controller/gate.outputs:execOut>
                custom rel inputs:prim = </World/crx5ia/root_joint> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                token node:type = "isaacsim.sensors.physics.IsaacReadJointState"
                int node:typeVersion = 1
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom uchar[] outputs:jointDofTypes
                custom double[] outputs:jointEfforts
                custom token[] outputs:jointNames
                custom double[] outputs:jointPositions
                custom double[] outputs:jointVelocities
                custom float outputs:sensorTime
                custom float outputs:stageMetersPerUnit
            }

            def OmniGraphNode "pub"
            {
                custom uint64 inputs:context
                delete uint64 inputs:context.connect = </World/ROS2/Topic_Based_Controller/ctx.outputs:context>
                prepend uint64 inputs:context.connect = </World/ROS2/Topic_Based_Controller/ctx.outputs:context>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Topic_Based_Controller/read.outputs:execOut>
                custom uchar[] inputs:jointDofTypes
                prepend uchar[] inputs:jointDofTypes.connect = </World/ROS2/Topic_Based_Controller/read.outputs:jointDofTypes>
                custom double[] inputs:jointEfforts
                prepend double[] inputs:jointEfforts.connect = </World/ROS2/Topic_Based_Controller/read.outputs:jointEfforts>
                custom token[] inputs:jointNames
                prepend token[] inputs:jointNames.connect = </World/ROS2/Topic_Based_Controller/read.outputs:jointNames>
                custom double[] inputs:jointPositions
                prepend double[] inputs:jointPositions.connect = </World/ROS2/Topic_Based_Controller/read.outputs:jointPositions>
                custom double[] inputs:jointVelocities
                prepend double[] inputs:jointVelocities.connect = </World/ROS2/Topic_Based_Controller/read.outputs:jointVelocities>
                custom string inputs:nodeNamespace
                custom string inputs:qosProfile
                prepend string inputs:qosProfile.connect = </World/ROS2/Topic_Based_Controller/qos.outputs:qosProfile>
                custom uint64 inputs:queueSize
                custom float inputs:sensorTime
                custom float inputs:stageMetersPerUnit
                prepend float inputs:stageMetersPerUnit.connect = </World/ROS2/Topic_Based_Controller/read.outputs:stageMetersPerUnit>
                custom rel inputs:targetPrim (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom double inputs:timeStamp
                prepend double inputs:timeStamp.connect = </World/ROS2/Topic_Based_Controller/time.outputs:simulationTime>
                custom string inputs:topicName
                token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
                int node:typeVersion = 1
            }

            def OmniGraphNode "sub"
            {
                custom uint64 inputs:context
                delete uint64 inputs:context.connect = </World/ROS2/Topic_Based_Controller/ctx.outputs:context>
                prepend uint64 inputs:context.connect = </World/ROS2/Topic_Based_Controller/ctx.outputs:context>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Topic_Based_Controller/physx.outputs:step>
                custom string inputs:nodeNamespace
                custom string inputs:qosProfile
                prepend string inputs:qosProfile.connect = </World/ROS2/Topic_Based_Controller/qos.outputs:qosProfile>
                custom uint64 inputs:queueSize
                custom string inputs:topicName
                token node:type = "isaacsim.ros2.bridge.ROS2SubscribeJointState"
                int node:typeVersion = 2
                custom double[] outputs:effortCommand
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom token[] outputs:jointNames
                custom double[] outputs:positionCommand
                custom double outputs:timeStamp
                custom double[] outputs:velocityCommand
            }

            def OmniGraphNode "ctrl"
            {
                custom double[] inputs:effortCommand
                prepend double[] inputs:effortCommand.connect = </World/ROS2/Topic_Based_Controller/sub.outputs:effortCommand>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Topic_Based_Controller/physx.outputs:step>
                custom int[] inputs:jointIndices
                custom token[] inputs:jointNames
                prepend token[] inputs:jointNames.connect = </World/ROS2/Topic_Based_Controller/sub.outputs:jointNames>
                custom double[] inputs:positionCommand
                prepend double[] inputs:positionCommand.connect = </World/ROS2/Topic_Based_Controller/sub.outputs:positionCommand>
                custom string inputs:robotPath = ""
                custom rel inputs:targetPrim = </World/crx5ia> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom double[] inputs:velocityCommand
                prepend double[] inputs:velocityCommand.connect = </World/ROS2/Topic_Based_Controller/sub.outputs:velocityCommand>
                token node:type = "isaacsim.core.nodes.IsaacArticulationController"
                int node:typeVersion = 1
            }

            def OmniGraphNode "ctx"
            {
                custom uchar inputs:domain_id
                custom bool inputs:useDomainIDEnvVar
                token node:type = "isaacsim.ros2.bridge.ROS2Context"
                int node:typeVersion = 2
                custom uint64 outputs:context
            }

            def OmniGraphNode "qos"
            {
                custom token inputs:createProfile (
                    allowedTokens = ["Default for publishers/subscribers", "Services", "Sensor Data", "System Default", "Custom"]
                )
                custom double inputs:deadline
                custom uint64 inputs:depth
                custom token inputs:durability (
                    allowedTokens = ["systemDefault", "transientLocal", "volatile", "unknown"]
                )
                custom token inputs:history (
                    allowedTokens = ["systemDefault", "keepLast", "keepAll", "unknown"]
                )
                custom double inputs:leaseDuration
                custom double inputs:lifespan
                custom token inputs:liveliness (
                    allowedTokens = ["systemDefault", "automatic", "manualByTopic", "unknown"]
                )
                custom token inputs:reliability (
                    allowedTokens = ["systemDefault", "reliable", "bestEffort", "unknown"]
                )
                token node:type = "isaacsim.ros2.bridge.ROS2QoSProfile"
                int node:typeVersion = 1
                custom string outputs:qosProfile
            }

            def OmniGraphNode "time"
            {
                custom uint64 inputs:referenceTimeDenominator
                custom int64 inputs:referenceTimeNumerator
                custom bool inputs:resetOnStop = 0
                token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
                int node:typeVersion = 1
                custom double outputs:simulationTime
            }

            def OmniGraphNode "clock"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = </World/ROS2/Topic_Based_Controller/ctx.outputs:context>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Topic_Based_Controller/physx.outputs:step>
                custom string inputs:nodeNamespace
                custom string inputs:qosProfile
                prepend string inputs:qosProfile.connect = </World/ROS2/Topic_Based_Controller/qos.outputs:qosProfile>
                custom uint64 inputs:queueSize
                custom double inputs:timeStamp
                prepend double inputs:timeStamp.connect = </World/ROS2/Topic_Based_Controller/time.outputs:simulationTime>
                custom string inputs:topicName
                token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
                int node:typeVersion = 1
            }
        }

        def OmniGraph "Camera_Publisher"
        {
            token evaluationMode = "Automatic"
            token evaluator:type = "execution"
            token fabricCacheBacking = "StageWithoutHistory"
            int2 fileFormatVersion = (1, 9)
            token pipelineStage = "pipelineStageSimulation"

            def OmniGraphNode "tick"
            {
                token node:type = "omni.graph.action.OnPlaybackTick"
                int node:typeVersion = 2
                custom double outputs:deltaSeconds
                custom double outputs:frame
                custom uint outputs:tick (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom double outputs:time
            }

            def OmniGraphNode "rp"
            {
                custom rel inputs:cameraPrim = </World/Zivid/projector> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom bool inputs:enabled
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </World/ROS2/Camera_Publisher/tick.outputs:tick>
                custom uint inputs:height = 700
                custom rel inputs:renderProductPrim (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
